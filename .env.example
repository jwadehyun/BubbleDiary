# Copy to .env and fill in. .env is git-ignored.
DB_USERNAME=root
DB_PASSWORD=
# Optional: a database other than MySQL on localhost, e.g. on your host's managed MySQL.
# DB_URL=jdbc:mysql://host:3306/bubblediary

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mobile app sign-in. APP_JWT_SECRET: 32+ random characters (openssl rand -base64 48).
# Without it, app sign-ins still work but end whenever the server restarts.
APP_JWT_SECRET=
# Optional: extra Google client ids (iOS/Android), comma-separated, and the iOS bundle id for Sign in with Apple.
# GOOGLE_MOBILE_CLIENT_IDS=
# APPLE_BUNDLE_ID=

OPENROUTER_API_KEY=
# Optional: which model writes replies for each plan (defaults to a free model). Uncomment to set.
# OPENROUTER_MODEL_FREE=anthropic/claude-haiku-5.5
# OPENROUTER_MODEL_PREMIUM=anthropic/claude-haiku-5.5
